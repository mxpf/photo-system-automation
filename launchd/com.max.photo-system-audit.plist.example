<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.max.photo-system-audit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/mxpf/Documents/Codex/photo-system-automation/src/photo_system_automation.py</string>
    <string>--audit</string>
    <string>both</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/mxpf/Documents/Codex/photo-system-automation/logs/photo-system-audit.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/mxpf/Documents/Codex/photo-system-automation/logs/photo-system-audit.err.log</string>
</dict>
</plist>

